{"$schema":"https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.4.0/schema.json","name":"conclusoes-limites","position":{"x":32,"y":714,"width":1216,"height":130,"z":50,"tabOrder":50},"visual":{"visualType":"textbox","objects":{"general":[{"properties":{"paragraphs":[{"textRuns":[{"value":"Como interpretar","textStyle":{"fontFamily":"Segoe UI","fontSize":"13pt","color":"#223B45","fontWeight":"bold"}}]},{"textRuns":[{"value":"Lucro bruto = receita menos custo de produto; a base não contém despesas operacionais. Participação na receita representa a distribuição das vendas da empresa por geografia. As recomendações indicam pontos para investigação; os dados não demonstram suas causas.","textStyle":{"fontFamily":"Segoe UI","fontSize":"13pt","color":"#223B45"}}]}]}}]},"visualContainerObjects":{"title":[{"properties":{"show":{"expr":{"Literal":{"Value":"false"}}}}}],"background":[{"properties":{"show":{"expr":{"Literal":{"Value":"false"}}}}}]}}}