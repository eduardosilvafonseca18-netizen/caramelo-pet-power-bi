{"$schema":"https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.4.0/schema.json","name":"p1-insights","position":{"x":32,"y":716,"width":1216,"height":138,"z":50,"tabOrder":50},"visual":{"visualType":"textbox","objects":{"general":[{"properties":{"paragraphs":[{"textRuns":[{"value":"Conclusões | base completa de 2014 a 2017","textStyle":{"fontFamily":"Segoe UI","fontSize":"13pt","color":"#223B45","fontWeight":"bold"}}]},{"textRuns":[{"value":"Receita de 73,65 milhões e lucro bruto de 35,66 milhões; margem de 48,41%. Argentina e Colômbia concentram 59,1% da receita. Em 2017, a receita cresceu 37,22% sobre 2016. Priorizar essas praças e revisar descontos no Brasil, que apresenta a menor margem (47,45%).","textStyle":{"fontFamily":"Segoe UI","fontSize":"13pt","color":"#223B45"}}]}]}}]},"visualContainerObjects":{"title":[{"properties":{"show":{"expr":{"Literal":{"Value":"false"}}}}}],"background":[{"properties":{"show":{"expr":{"Literal":{"Value":"false"}}}}}]}}}