        ],
        "partitions": [
          {
            "name": "fact_Vendas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // Cópia portátil da base fornecida, preservada no próprio projeto.",
                "    Fonte = Csv.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=\",\", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {{\"VendaID\", Int64.Type}, {\"ProdutoID\", Int64.Type}, {\"RepresentanteID\", Int64.Type}, {\"LocalizacaoID\", type text}, {\"Data\", type date}, {\"Unidades\", Int64.Type}, {\"FatorCusto\", type number}, {\"Desconto\", type number}}, \"en-US\"),",
                "    SemErros = Table.RemoveRowsWithErrors(Tipos),",
                "    ChavesLimpas = Table.TransformColumns(SemErros, {{\"LocalizacaoID\", each if _ = null then null else Text.Trim(Text.Clean(_)), type text}}),",
                "    DescontoSemNulos = Table.ReplaceValue(ChavesLimpas, null, 0, Replacer.ReplaceValue, {\"Desconto\"}),",
                "    RegistrosValidos = Table.SelectRows(DescontoSemNulos, each [VendaID] <> null and [ProdutoID] <> null and [RepresentanteID] <> null and [LocalizacaoID] <> null and [LocalizacaoID] <> \"\" and [Data] <> null and [Unidades] <> null and [Unidades] > 0 and [FatorCusto] <> null and [FatorCusto] >= 0 and [Desconto] >= 0 and [Desconto] <= 1),",
                "    ChavesUnicas = Table.Distinct(RegistrosValidos, {\"VendaID\"}),",
                "    ProdutoValido = Table.NestedJoin(ChavesUnicas, {\"ProdutoID\"}, dim_Produto, {\"ProdutoID\"}, \"Produto\", JoinKind.Inner),",
                "    Precos = Table.ExpandTableColumn(ProdutoValido, \"Produto\", {\"PrecoVarejo\", \"CustoPadrao\"}, {\"PrecoVarejo\", \"CustoPadrao\"}),",
                "    RepresentanteValido = Table.NestedJoin(Precos, {\"RepresentanteID\"}, dim_Representante, {\"RepresentanteID\"}, \"Representante\", JoinKind.Inner),",
                "    SemRepresentante = Table.RemoveColumns(RepresentanteValido, {\"Representante\"}),",
                "    GeografiaValida = Table.NestedJoin(SemRepresentante, {\"LocalizacaoID\"}, dim_Geografia, {\"LocalizacaoID\"}, \"Geografia\", JoinKind.Inner),",
                "    SemGeografia = Table.RemoveColumns(GeografiaValida, {\"Geografia\"}),",
                "    ReceitaCalculada = Table.AddColumn(SemGeografia, \"Receita\", each [Unidades] * [PrecoVarejo] * (1 - [Desconto]), type number),",
                "    CustoCalculado = Table.AddColumn(ReceitaCalculada, \"Custo\", each [Unidades] * [CustoPadrao] * [FatorCusto], type number),",
                "    LucroCalculado = Table.AddColumn(CustoCalculado, \"Lucro\", each [Receita] - [Custo], type number),",
                "    MesAuxiliar = Table.AddColumn(LucroCalculado, \"Data (Month)\", each Date.StartOfMonth([Data]), type date),",
                "    DiaAuxiliar = Table.AddColumn(MesAuxiliar, \"Data (Day)\", each [Data], type date),",
                "    Resultado = Table.RemoveColumns(DiaAuxiliar, {\"PrecoVarejo\", \"CustoPadrao\"})",
                "in",
                "    Resultado"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "DimDate",
        "description": "Calendário contínuo entre o início e o fim dos anos cobertos pelas vendas; chave Date única e sem nulos. Dimensão de datas única do modelo.",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "formatString": "dd/MM/yyyy",
            "summarizeBy": "none",
            "isKey": true
          },
          {
            "name": "Ano",
            "dataType": "int64",
            "sourceColumn": "Ano",
            "formatString": "0",
            "summarizeBy": "none"
          },
          {
            "name": "MesNumero",
            "dataType": "int64",
            "sourceColumn": "MesNumero",
            "formatString": "0",
            "summarizeBy": "none"
          },
          {
            "name": "NomeMes",
            "dataType": "string",
            "sourceColumn": "NomeMes",
            "summarizeBy": "none",
            "sortByColumn": "MesNumero"
          },
          {
            "name": "AnoMes",
            "dataType": "string",
            "sourceColumn": "AnoMes",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "dim_Calendario Record Count",
            "expression": [
              "COUNTROWS('DimDate')"
            ],
            "description": "Conta as linhas de DimDate no contexto de filtro atual.",
            "displayFolder": "Medidas de apoio",
            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "DimDate",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Inicio = #date(Date.Year(List.Min(fact_Vendas[Data])), 1, 1),",
                "    Fim = #date(Date.Year(List.Max(fact_Vendas[Data])), 12, 31),",
                "    Datas = List.Dates(Inicio, Duration.Days(Fim - Inicio) + 1, #duration(1, 0, 0, 0)),",
                "    Tabela = Table.FromList(Datas, Splitter.SplitByNothing(), {\"Date\"}, null, ExtraValues.Error),",
                "    Tipos = Table.TransformColumnTypes(Tabela, {{\"Date\", type date}}),",
                "    Ano = Table.AddColumn(Tipos, \"Ano\", each Date.Year([Date]), Int64.Type),",
                "    MesNumero = Table.AddColumn(Ano, \"MesNumero\", each Date.Month([Date]), Int64.Type),",
                "    NomeMes = Table.AddColumn(MesNumero, \"NomeMes\", each Date.ToText([Date], [Format=\"MMM\", Culture=\"pt-BR\"]), type text),",
                "    AnoMes = Table.AddColumn(NomeMes, \"AnoMes\", each Date.ToText([Date], [Format=\"yyyy-MM\", Culture=\"pt-BR\"]), type text)",
                "in",
                "    AnoMes"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "dataCategory": "Time"
      }
