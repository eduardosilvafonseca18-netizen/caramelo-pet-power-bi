{
  "name": "CarameloPet",
  "compatibilityLevel": 1601,
  "model": {
    "culture": "pt-BR",
    "sourceQueryCulture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "dim_Produto",
        "description": "Preparada no Power Query com tipagem, validação de registros e tratamento de dados. Dimensão do modelo estrela.",
        "columns": [
          {
            "name": "ProdutoID",
            "dataType": "int64",
            "sourceColumn": "ProdutoID",
            "summarizeBy": "none",
            "formatString": "#,0",
            "isHidden": true
          },
          {
            "name": "SubcategoriaID",
            "dataType": "int64",
            "sourceColumn": "SubcategoriaID",
            "summarizeBy": "none",
            "formatString": "#,0",
            "isHidden": true
          },
          {
            "name": "Cor",
            "dataType": "double",
            "sourceColumn": "Cor",
            "summarizeBy": "none",
            "formatString": "#,0.00;(#,0.00);-"
          },
          {
            "name": "NomeProduto",
            "dataType": "double",
            "sourceColumn": "NomeProduto",
            "summarizeBy": "none",
            "formatString": "#,0.00;(#,0.00);-"
          },
          {
            "name": "PrecoVarejo",
            "dataType": "double",
            "sourceColumn": "PrecoVarejo",
            "summarizeBy": "none",
            "formatString": "#,0.00;(#,0.00);-"
          },
          {
            "name": "CustoPadrao",
            "dataType": "double",
            "sourceColumn": "CustoPadrao",
            "summarizeBy": "none",
            "formatString": "#,0.00;(#,0.00);-"
          },
          {
            "name": "CategoriaKey",
            "dataType": "int64",
            "sourceColumn": "CategoriaKey",
            "summarizeBy": "none",
            "formatString": "#,0",
            "isHidden": true
          },
          {
            "name": "SubCategoriaNome",
            "dataType": "double",
            "sourceColumn": "SubCategoriaNome",
            "summarizeBy": "none",
            "formatString": "#,0.00;(#,0.00);-"
          },
          {
            "name": "Categoria",
            "dataType": "double",
            "sourceColumn": "Categoria",
            "summarizeBy": "none",
            "formatString": "#,0.00;(#,0.00);-"
          }
        ],
        "measures": [
          {
            "name": "Distinct ProdutoID (dim_Produto)",
            "expression": [
              "DISTINCTCOUNT('dim_Produto'[ProdutoID])"
            ],
            "description": "Conta os valores distintos de ProdutoID em dim_Produto, respeitando o contexto de filtro. No cadastro conta itens disponíveis; na fato conta itens com vendas na seleção.",
            "displayFolder": "Medidas de apoio",
            "formatString": "#,0"
          },
          {
            "name": "Distinct SubcategoriaID",
            "expression": [
              "DISTINCTCOUNT('dim_Produto'[SubcategoriaID])"
            ],
            "description": "Conta os valores distintos de SubcategoriaID em dim_Produto, respeitando o contexto de filtro. No cadastro conta itens disponíveis; na fato conta itens com vendas na seleção.",
            "displayFolder": "Medidas de apoio",
            "formatString": "#,0"
          },
          {
            "name": "Average PrecoVarejo",
            "expression": [
              "AVERAGE('dim_Produto'[PrecoVarejo])"
            ],
            "description": "Média aritmética de dim_Produto[PrecoVarejo] nas linhas visíveis. Na fato é uma média por registro de venda, sem ponderação adicional; no cadastro é uma média por item.",
            "displayFolder": "Medidas de apoio",
            "formatString": "#,0.00;(#,0.00);-"
          },
          {
            "name": "Max PrecoVarejo",
            "expression": [
              "MAX('dim_Produto'[PrecoVarejo])"
            ],
            "description": "Maior valor de dim_Produto[PrecoVarejo] no contexto de filtro atual.",
            "displayFolder": "Medidas de apoio",
            "formatString": "#,0.00;(#,0.00);-"
          },
          {
            "name": "Average CustoPadrao",
            "expression": [
              "AVERAGE('dim_Produto'[CustoPadrao])"
            ],
            "description": "Média aritmética de dim_Produto[CustoPadrao] nas linhas visíveis. Na fato é uma média por registro de venda, sem ponderação adicional; no cadastro é uma média por item.",
            "displayFolder": "Medidas de apoio",
            "formatString": "#,0.00;(#,0.00);-"
          },
          {
            "name": "Max CustoPadrao",
            "expression": [
              "MAX('dim_Produto'[CustoPadrao])"
            ],
            "description": "Maior valor de dim_Produto[CustoPadrao] no contexto de filtro atual.",
            "displayFolder": "Medidas de apoio",
            "formatString": "#,0.00;(#,0.00);-"
          },
          {
            "name": "Distinct CategoriaKey",
            "expression": [
              "DISTINCTCOUNT('dim_Produto'[CategoriaKey])"
            ],
            "description": "Conta os valores distintos de CategoriaKey em dim_Produto, respeitando o contexto de filtro. No cadastro conta itens disponíveis; na fato conta itens com vendas na seleção.",
            "displayFolder": "Medidas de apoio",
            "formatString": "#,0"
          },
          {
            "name": "dim_Produto Record Count",
            "expression": [
              "COUNTROWS('dim_Produto')"
            ],
            "description": "Conta as linhas de dim_Produto no contexto de filtro atual.",
            "displayFolder": "Medidas de apoio",
            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "dim_Produto",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // Cópia portátil da base fornecida, preservada no próprio projeto.",
                "    Fonte = Csv.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=\",\", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {{\"ProdutoID\", Int64.Type}, {\"SubcategoriaID\", Int64.Type}, {\"PrecoVarejo\", type number}, {\"CustoPadrao\", type number}, {\"CategoriaKey\", Int64.Type}, {\"Cor\", type text}, {\"NomeProduto\", type text}, {\"SubCategoriaNome\", type text}, {\"Categoria\", type text}}, \"en-US\"),",
                "    SemErros = Table.RemoveRowsWithErrors(Tipos),",
                "    TextosLimpos = Table.TransformColumns(SemErros, {{\"Cor\", each if _ = null or Text.Trim(Text.Clean(Text.From(_))) = \"\" then \"Não informado\" else Text.Trim(Text.Clean(Text.From(_))), type text}, {\"NomeProduto\", each if _ = null or Text.Trim(Text.Clean(Text.From(_))) = \"\" then \"Não informado\" else Text.Trim(Text.Clean(Text.From(_))), type text}, {\"SubCategoriaNome\", each if _ = null or Text.Trim(Text.Clean(Text.From(_))) = \"\" then \"Não informado\" else Text.Trim(Text.Clean(Text.From(_))), type text}, {\"Categoria\", each if _ = null or Text.Trim(Text.Clean(Text.From(_))) = \"\" then \"Não informado\" else Text.Trim(Text.Clean(Text.From(_))), type text}}),",
                "    RegistrosValidos = Table.SelectRows(TextosLimpos, each [ProdutoID] <> null and [ProdutoID] > 0 and [PrecoVarejo] <> null and [PrecoVarejo] >= 0 and [CustoPadrao] <> null and [CustoPadrao] >= 0),",
                "    ChavesUnicas = Table.Distinct(RegistrosValidos, {\"ProdutoID\"})",
                "in",
                "    ChavesUnicas"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "dim_Representante",
