          },
          {
            "name": "dim_Geografia Record Count",
            "expression": [
              "COUNTROWS('dim_Geografia')"
            ],
            "description": "Conta as linhas de dim_Geografia no contexto de filtro atual.",
            "displayFolder": "Medidas de apoio",
            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "dim_Geografia",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // Cópia portátil da base fornecida, preservada no próprio projeto.",
                "    Fonte = Csv.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=\",\", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {{\"País\", type text}, {\"Cidade\", type text}, {\"Wikipedia\", type text}, {\"LocalizacaoID\", type text}}, \"en-US\"),",
                "    SemErros = Table.RemoveRowsWithErrors(Tipos),",
                "    ChavesLimpas = Table.TransformColumns(SemErros, {{\"LocalizacaoID\", each if _ = null then null else Text.Trim(Text.Clean(_)), type text}}),",
                "    TextosLimpos = Table.TransformColumns(ChavesLimpas, {{\"País\", each if _ = null or Text.Trim(Text.Clean(Text.From(_))) = \"\" then \"Não informado\" else Text.Trim(Text.Clean(Text.From(_))), type text}, {\"Cidade\", each if _ = null or Text.Trim(Text.Clean(Text.From(_))) = \"\" then \"Não informado\" else Text.Trim(Text.Clean(Text.From(_))), type text}}),",
                "    RegistrosValidos = Table.SelectRows(TextosLimpos, each [LocalizacaoID] <> null and [LocalizacaoID] <> \"\"),",
                "    ChavesUnicas = Table.Distinct(RegistrosValidos, {\"LocalizacaoID\"})",
                "in",
                "    ChavesUnicas"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "fact_Vendas",
        "description": "Preparada no Power Query com tipagem, validação de registros e tratamento de dados. Fato de vendas com receita, custo e lucro bruto calculados após associação ao cadastro de produtos.",
        "columns": [
          {
            "name": "VendaID",
            "dataType": "int64",
            "sourceColumn": "VendaID",
            "summarizeBy": "none",
            "formatString": "#,0",
            "isHidden": true
          },
          {
            "name": "ProdutoID",
            "dataType": "int64",
            "sourceColumn": "ProdutoID",
            "summarizeBy": "none",
            "formatString": "#,0",
            "isHidden": true
          },
          {
            "name": "RepresentanteID",
            "dataType": "int64",
            "sourceColumn": "RepresentanteID",
            "summarizeBy": "none",
            "formatString": "#,0",
            "isHidden": true
          },
          {
            "name": "LocalizacaoID",
            "dataType": "int64",
            "sourceColumn": "LocalizacaoID",
            "summarizeBy": "none",
            "formatString": "#,0",
            "isHidden": true
          },
          {
            "name": "Data",
            "dataType": "dateTime",
            "sourceColumn": "Data",
            "summarizeBy": "none",
            "formatString": "dd/MM/yyyy"
          },
          {
            "name": "Data (Month)",
            "dataType": "dateTime",
            "sourceColumn": "Data (Month)",
            "summarizeBy": "none",
            "formatString": "MMM yyyy",
            "isHidden": true
          },
          {
            "name": "Unidades",
            "dataType": "int64",
            "sourceColumn": "Unidades",
            "summarizeBy": "sum",
            "formatString": "#,0"
          },
          {
            "name": "FatorCusto",
            "dataType": "double",
            "sourceColumn": "FatorCusto",
            "summarizeBy": "none",
            "formatString": "0.00%"
          },
          {
            "name": "Desconto",
            "dataType": "double",
            "sourceColumn": "Desconto",
            "summarizeBy": "none",
            "formatString": "0.00%"
          },
          {
            "name": "Receita",
            "dataType": "double",
            "sourceColumn": "Receita",
            "summarizeBy": "sum",
            "formatString": "#,0.00;(#,0.00);-"
          },
          {
            "name": "Custo",
            "dataType": "double",
            "sourceColumn": "Custo",
            "summarizeBy": "sum",
            "formatString": "#,0.00;(#,0.00);-"
          },
          {
            "name": "Lucro",
            "dataType": "double",
            "sourceColumn": "Lucro",
            "summarizeBy": "sum",
            "formatString": "#,0.00;(#,0.00);-"
          },
          {
            "name": "Data (Day)",
            "dataType": "dateTime",
            "sourceColumn": "Data (Day)",
            "summarizeBy": "none",
            "formatString": "dd/MM/yyyy",
            "isHidden": true
          }
        ],
        "measures": [
          {
            "name": "Distinct VendaID",
            "expression": [
              "DISTINCTCOUNT('fact_Vendas'[VendaID])"
            ],
            "description": "Conta os valores distintos de VendaID em fact_Vendas, respeitando o contexto de filtro. No cadastro conta itens disponíveis; na fato conta itens com vendas na seleção.",
            "displayFolder": "Medidas de apoio",
            "formatString": "#,0"
          },
          {
            "name": "Distinct ProdutoID (fact_Vendas)",
            "expression": [
              "DISTINCTCOUNT('fact_Vendas'[ProdutoID])"
            ],
            "description": "Conta os valores distintos de ProdutoID em fact_Vendas, respeitando o contexto de filtro. No cadastro conta itens disponíveis; na fato conta itens com vendas na seleção.",
            "displayFolder": "Medidas de apoio",
            "formatString": "#,0"
          },
          {
            "name": "Distinct RepresentanteID (fact_Vendas)",
            "expression": [
              "DISTINCTCOUNT('fact_Vendas'[RepresentanteID])"
            ],
            "description": "Conta os valores distintos de RepresentanteID em fact_Vendas, respeitando o contexto de filtro. No cadastro conta itens disponíveis; na fato conta itens com vendas na seleção.",
            "displayFolder": "Medidas de apoio",
            "formatString": "#,0"
          },
          {
            "name": "Distinct LocalizacaoID (fact_Vendas)",
            "expression": [
              "DISTINCTCOUNT('fact_Vendas'[LocalizacaoID])"
            ],
            "description": "Conta os valores distintos de LocalizacaoID em fact_Vendas, respeitando o contexto de filtro. No cadastro conta itens disponíveis; na fato conta itens com vendas na seleção.",
            "displayFolder": "Medidas de apoio",
            "formatString": "#,0"
          },
          {
            "name": "Total Unidades",
            "expression": [
              "SUM('fact_Vendas'[Unidades])"
            ],
            "description": "Soma as unidades vendidas nos registros selecionados.",
            "displayFolder": "Totais",
            "formatString": "#,0"
          },
          {
            "name": "Average Unidades",
            "expression": [
              "AVERAGE('fact_Vendas'[Unidades])"
            ],
            "description": "Média aritmética de fact_Vendas[Unidades] nas linhas visíveis. Na fato é uma média por registro de venda, sem ponderação adicional; no cadastro é uma média por item.",
            "displayFolder": "Medidas de apoio",
            "formatString": "#,0.00;(#,0.00);-"
          },
          {
            "name": "Max Unidades",
            "expression": [
              "MAX('fact_Vendas'[Unidades])"
            ],
            "description": "Maior valor de fact_Vendas[Unidades] no contexto de filtro atual.",
            "displayFolder": "Medidas de apoio",
            "formatString": "#,0.00;(#,0.00);-"
          },
          {
            "name": "Unidades Running Total",
            "expression": [
              "VAR Limite = MAX('DimDate'[Date])",
              "RETURN CALCULATE([Total Unidades], FILTER(ALLSELECTED('DimDate'[Date]), 'DimDate'[Date] <= Limite))"
            ],
            "description": "Acumula unidades até a data do ponto atual, dentro do período selecionado; mantém os filtros de produto, representante e geografia.",
            "displayFolder": "Comparações temporais",
            "formatString": "#,0"
          },
          {
            "name": "Unidades Change vs Prior Month",
            "expression": [
              "VAR UltimaData = MAX('DimDate'[Date])",
              "VAR InicioAtual = DATE(YEAR(UltimaData), MONTH(UltimaData), 1)",
              "VAR InicioAnterior = EDATE(InicioAtual, -1)",
              "VAR Atual = CALCULATE([Total Unidades], FILTER(ALL('DimDate'), 'DimDate'[Date] >= InicioAtual && 'DimDate'[Date] <= EOMONTH(InicioAtual, 0)))",
              "VAR Anterior = CALCULATE([Total Unidades], FILTER(ALL('DimDate'), 'DimDate'[Date] >= InicioAnterior && 'DimDate'[Date] <= EOMONTH(InicioAnterior, 0)))",
              "RETURN IF(ISBLANK(Anterior), BLANK(), Atual - Anterior)"
            ],
            "description": "Diferença absoluta de unidades entre o último mês selecionado e o mês anterior, ambos completos. Remove somente o filtro de calendário para alcançar o mês anterior. Sem histórico retorna vazio; não é uma taxa percentual.",
            "displayFolder": "Comparações temporais",
            "formatString": "#,0"
          },
          {
            "name": "Unidades Direction",
            "expression": [
              "VAR Variacao = [Unidades Change vs Prior Month]",
              "RETURN IF(ISBLANK(Variacao), BLANK(), IF(Variacao > 0, UNICHAR(9650), IF(Variacao < 0, UNICHAR(9660), UNICHAR(9658))))"
            ],
            "description": "Seta que indica se unidades cresceu, caiu ou ficou estável em relação ao mês anterior. Sem comparação disponível retorna vazio.",
            "displayFolder": "Comparações temporais"
          },
          {
            "name": "Unidades Sign",
            "expression": [
              "VAR Variacao = [Unidades Change vs Prior Month]",
              "RETURN IF(ISBLANK(Variacao), BLANK(), SIGN(Variacao))"
            ],
            "description": "Sinal da variação mensal de unidades: 1 para aumento, -1 para queda e 0 para estabilidade. Sem histórico retorna vazio.",
            "displayFolder": "Comparações temporais",
            "formatString": "0"
          },
          {
            "name": "Average FatorCusto",
            "expression": [
              "AVERAGE('fact_Vendas'[FatorCusto])"
            ],
            "description": "Média aritmética de fact_Vendas[FatorCusto] nas linhas visíveis. Na fato é uma média por registro de venda, sem ponderação adicional; no cadastro é uma média por item.",
            "displayFolder": "Medidas de apoio",
            "formatString": "#,0.00;(#,0.00);-"
          },
          {
            "name": "Max FatorCusto",
            "expression": [
              "MAX('fact_Vendas'[FatorCusto])"
            ],
            "description": "Maior valor de fact_Vendas[FatorCusto] no contexto de filtro atual.",
            "displayFolder": "Medidas de apoio",
            "formatString": "#,0.00;(#,0.00);-"
          },
          {
            "name": "Total Receita",
            "expression": [
              "SUM('fact_Vendas'[Receita])"
            ],
            "description": "Soma a receita líquida de desconto: unidades × preço de varejo × (1 − desconto). Respeita os filtros ativos.",
            "displayFolder": "Totais",
            "formatString": "#,0.00;(#,0.00);-"
          },
          {
            "name": "Average Receita",
            "expression": [
              "AVERAGE('fact_Vendas'[Receita])"
            ],
            "description": "Média aritmética de fact_Vendas[Receita] nas linhas visíveis. Na fato é uma média por registro de venda, sem ponderação adicional; no cadastro é uma média por item.",
            "displayFolder": "Medidas de apoio",
            "formatString": "#,0.00;(#,0.00);-"
          },
          {
            "name": "Max Receita",
            "expression": [
              "MAX('fact_Vendas'[Receita])"
            ],
            "description": "Maior valor de fact_Vendas[Receita] no contexto de filtro atual.",
            "displayFolder": "Medidas de apoio",
            "formatString": "#,0.00;(#,0.00);-"
          },
          {
            "name": "Receita Running Total",
            "expression": [
              "VAR Limite = MAX('DimDate'[Date])",
              "RETURN CALCULATE([Total Receita], FILTER(ALLSELECTED('DimDate'[Date]), 'DimDate'[Date] <= Limite))"
            ],
            "description": "Acumula receita até a data do ponto atual, dentro do período selecionado; mantém os filtros de produto, representante e geografia.",
            "displayFolder": "Comparações temporais",
            "formatString": "#,0.00;(#,0.00);-"
          },
          {
            "name": "Receita Change vs Prior Month",
            "expression": [
              "VAR UltimaData = MAX('DimDate'[Date])",
              "VAR InicioAtual = DATE(YEAR(UltimaData), MONTH(UltimaData), 1)",
              "VAR InicioAnterior = EDATE(InicioAtual, -1)",
              "VAR Atual = CALCULATE([Total Receita], FILTER(ALL('DimDate'), 'DimDate'[Date] >= InicioAtual && 'DimDate'[Date] <= EOMONTH(InicioAtual, 0)))",
              "VAR Anterior = CALCULATE([Total Receita], FILTER(ALL('DimDate'), 'DimDate'[Date] >= InicioAnterior && 'DimDate'[Date] <= EOMONTH(InicioAnterior, 0)))",
              "RETURN IF(ISBLANK(Anterior), BLANK(), Atual - Anterior)"
            ],
            "description": "Diferença absoluta de receita entre o último mês selecionado e o mês anterior, ambos completos. Remove somente o filtro de calendário para alcançar o mês anterior. Sem histórico retorna vazio; não é uma taxa percentual.",
            "displayFolder": "Comparações temporais",
            "formatString": "#,0.00;(#,0.00);-"
          },
          {
            "name": "Receita Direction",
            "expression": [
              "VAR Variacao = [Receita Change vs Prior Month]",
              "RETURN IF(ISBLANK(Variacao), BLANK(), IF(Variacao > 0, UNICHAR(9650), IF(Variacao < 0, UNICHAR(9660), UNICHAR(9658))))"
            ],
            "description": "Seta que indica se receita cresceu, caiu ou ficou estável em relação ao mês anterior. Sem comparação disponível retorna vazio.",
            "displayFolder": "Comparações temporais"
          },
          {
            "name": "Receita Sign",
            "expression": [
              "VAR Variacao = [Receita Change vs Prior Month]",
              "RETURN IF(ISBLANK(Variacao), BLANK(), SIGN(Variacao))"
            ],
            "description": "Sinal da variação mensal de receita: 1 para aumento, -1 para queda e 0 para estabilidade. Sem histórico retorna vazio.",
            "displayFolder": "Comparações temporais",
            "formatString": "0"
          },
