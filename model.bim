            "displayFolder": "Medidas de apoio",
            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "dim_Representante",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // Cópia portátil da base fornecida, preservada no próprio projeto.",
                "    Fonte = Csv.Document(Binary.Decompress(Binary.FromText(\"TYw7DgIxDAV7n8IHSMO/R0sBEggFif4pa0Sk4CxOwoU4ChcjdLTz5o2XyaSIVmiV/eBO+SH+n9HaHfLnnfkso2XauK01zTxEFFq5XUqifI1Q0MIdYSGim9ZCiDTrT0W9Q7kvzyaF5s7jBkk/R6KBlj0hCh7Bl5heoC8=\", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=\",\", Columns=2, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {{\"RepresentanteID\", Int64.Type}, {\"NomeRepresentante\", type text}}, \"en-US\"),",
                "    SemErros = Table.RemoveRowsWithErrors(Tipos),",
                "    TextosLimpos = Table.TransformColumns(SemErros, {{\"NomeRepresentante\", each if _ = null or Text.Trim(Text.Clean(Text.From(_))) = \"\" then \"Não informado\" else Text.Trim(Text.Clean(Text.From(_))), type text}}),",
                "    RegistrosValidos = Table.SelectRows(TextosLimpos, each [RepresentanteID] <> null and [RepresentanteID] > 0),",
                "    ChavesUnicas = Table.Distinct(RegistrosValidos, {\"RepresentanteID\"})",
                "in",
                "    ChavesUnicas"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "dim_Geografia",
        "description": "Preparada no Power Query com tipagem, validação de registros e tratamento de dados. Dimensão do modelo estrela.",
        "columns": [
